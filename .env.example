# Server secrets: set these locally or in Render's environment dashboard.
GEMINI_API_KEY=
BRIGHTDATA_API_KEY=
# Set a SERP zone or an Unlocker zone enabled for search in your account.
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_COLLECTOR_ID=
# Optional: configure only collectors trained for these specific ATS sites.
BRIGHTDATA_ASHBY_COLLECTOR_ID=
BRIGHTDATA_GREENHOUSE_COLLECTOR_ID=
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated exact frontend origins. Empty means same-origin only.
CORS_ORIGINS=
HOST=0.0.0.0
# Empty picks a free port locally. Render injects PORT automatically.
PORT=
PROVIDER_TIMEOUT_SECONDS=120
DISCOVERY_TIMEOUT_SECONDS=900
MAX_CONCURRENT_REQUESTS=2
# Opt-in: repairs AND approves changes to the shared collector.
BRIGHTDATA_AUTO_HEAL=false
# Frontend BUILD environment only; leave empty for unified Docker/local use.
# Set this in Vercel to the Render HTTPS origin, then rebuild.
PUBLIC_API_BASE_URL=
